{
  "name": "tide-and-tidy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tide & Tidy — a calm, random 2D tidy-up game. Jar every critter, shelve every jar. Vite + vanilla TS + Canvas + Web Audio.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
