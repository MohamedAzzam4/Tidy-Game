{
  "name": "cozy-corner-tidying",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "One-level browser prototype of a cozy PC tidying game. Vite + vanilla TypeScript + SVG.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
